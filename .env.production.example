# Neutron ControlForge - production Docker Compose
# Copy to .env.production and replace BOTH secrets.
# Do not commit .env.production.

POSTGRES_PASSWORD=replace-with-a-strong-database-password
AGENTGUARD_ADMIN_KEY=replace-with-a-long-random-admin-secret
CONTROLFORGE_API_PORT=8000
CONTROLFORGE_DASHBOARD_PORT=3000
